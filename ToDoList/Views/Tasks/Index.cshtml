@model IEnumerable<ToDoItem>
@{
    ViewData["Title"] = "TodoItem List";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet" />

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .65)), url('/images/background.jpg') center / cover fixed no-repeat;
        min-height: 100vh;
    }

    .main-container {
        width: 90%;
        margin: 25px auto;
        padding: 30px;
        background: rgba(255, 255, 255, .94);
        border-radius: 15px;
        min-height: 500px;
    }

    .table tbody td.deadline {
        background-color: #f8d7da !important;
        color: #842029 !important;
    }

    .table th,
    .table td {
        vertical-align: middle;
        white-space: nowrap;
    }

    .table-responsive {
        overflow-x: auto;
    }

    @@media (max-width: 768px) {
        .main-container {
            width: 96%;
            padding: 15px;
        }
    }
</style>

<div class="main-container">

    <h2 class="fw-bold mb-2">TodoItem List</h2>

    <a asp-controller="Tasks"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Add New Task
    </a>

    <form asp-controller="Tasks"
          asp-action="Index"
          method="get"
          class="d-flex gap-2 mb-3">

        <input type="date"
               name="date"
               class="form-control"
               style="max-width: 165px"
               value="@Context.Request.Query["date"]" />

        <button type="submit" class="btn btn-primary">
            Search
        </button>

    </form>

    <div class="table-responsive">

        <table class="table table-bordered table-hover bg-white">

            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Deadline</th>
                    <th>File</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var task in Model)
                    {
                        <tr>

                            <td>@task.Title</td>

                            <td>@task.Description</td>

                            @{
                                var timeLeft = task.Deadline - DateTime.Now;
                                var isDeadlineNear = timeLeft.TotalHours <= 24;
                            }

                            <td class="@(isDeadlineNear ? "deadline" : "")">
                                @task.Deadline.ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(task.FilePath))
                                {
                                    <a asp-controller="Tasks"
                                       asp-action="Download"
                                       asp-route-id="@task.Id"
                                       class="btn btn-success btn-sm">
                                        Download
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">No file</span>
                                }

                            </td>

                            <td>
                                <a asp-controller="Tasks"
                                   asp-action="Update"
                                   asp-route-id="@task.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form asp-controller="Tasks"
                                      asp-action="Delete"
                                      asp-route-id="@task.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this task?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            No tasks found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>


    </div>

 
    @if ((int)ViewBag.TotalPages > 1)
    {
        <nav aria-label="Tasks pagination">
            <ul class="pagination justify-content-center mt-3">

                <li class="page-item @( (int)ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="Tasks"
                       asp-action="Index"
                       asp-route-page="@((int)ViewBag.CurrentPage - 1)"
                       asp-route-date="@Context.Request.Query["date"]">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Tasks"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-date="@Context.Request.Query["date"]">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @( (int)ViewBag.CurrentPage >= (int)ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="Tasks"
                       asp-action="Index"
                       asp-route-page="@((int)ViewBag.CurrentPage + 1)"
                       asp-route-date="@Context.Request.Query["date"]">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
    }


</div>
